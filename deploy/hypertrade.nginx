# 发布窗口遮蔽：`docker compose up -d` 会重建 sandbox/api/worker，api(:3334) 在这段时间没有监听。
# 前端静态资源由 nginx 直接从 /opt/hypertrade/frontend/dist 提供，页面照常打开；
# 需要处理的是 /api/：后端关闭时快速失败并 retry，仍失败则返回可解析 JSON + Retry-After。
# 健康检查与 WebSocket 不拦截：监控/探针要看到真实状态，行情推送不能被错误页打断。
upstream hypertrade_api {
    server 127.0.0.1:3334 max_fails=0;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name hypertrade.notenap.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:8460 ssl http2;
    server_name hypertrade.notenap.com;

    ssl_certificate /etc/letsencrypt/live/hypertrade.notenap.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hypertrade.notenap.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:hypertrade:10m;
    ssl_session_timeout 1d;

    root /opt/hypertrade/frontend/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ws/ {
        proxy_pass http://127.0.0.1:3334;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # 健康检查直通：不拦截错误、不缓存，监控与发布探针必须看到真实状态。
    location = /api/health {
        access_log off;
        proxy_pass http://hypertrade_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503;
    }

    location /api/ {
        proxy_pass http://hypertrade_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        proxy_intercept_errors on;
        error_page 502 503 504 = @hypertrade_api_restarting;
    }

    location @hypertrade_api_restarting {
        internal;
        default_type application/json;
        add_header Retry-After 3 always;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"service_restarting","message":"HyperTrade 正在发布新版本，请 3 秒后重试","retry_after":3}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 3333;
    server_name _;

    root /opt/hypertrade/frontend/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location /api/ws/ {
        proxy_pass http://127.0.0.1:3334;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # 健康检查直通：不拦截错误、不缓存，监控与发布探针必须看到真实状态。
    location = /api/health {
        access_log off;
        proxy_pass http://hypertrade_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_next_upstream error timeout http_502 http_503;
    }

    location /api/ {
        proxy_pass http://hypertrade_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 300s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        proxy_intercept_errors on;
        error_page 502 503 504 = @hypertrade_api_restarting;
    }

    location @hypertrade_api_restarting {
        internal;
        default_type application/json;
        add_header Retry-After 3 always;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"service_restarting","message":"HyperTrade 正在发布新版本，请 3 秒后重试","retry_after":3}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
