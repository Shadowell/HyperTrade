# Server-only evaluation environment. Copy to /opt/hypertrade-eval/.env and
# replace the placeholder values there. Do not copy production .env values.
HYPERTRADE_EVAL_TARGET=isolated
HYPERTRADE_EVAL_IMAGE=hypertrade-api:latest
HYPERTRADE_EVAL_PORT=4334

APP_ENV=evaluation
APP_NAME=HyperTrade Evaluation
API_HOST=0.0.0.0
API_PORT=3334
FRONTEND_ORIGIN=http://127.0.0.1:4334

POSTGRES_DB=hypertrade_eval
POSTGRES_USER=hypertrade_eval
POSTGRES_PASSWORD=REPLACE_WITH_EVAL_DATABASE_PASSWORD

ADMIN_USERNAME=eval-admin
ADMIN_PASSWORD=REPLACE_WITH_EVAL_ADMIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_EVAL_SESSION_SECRET
COOKIE_SECURE=false

# The source stays on the server and is mounted only into the evaluation API as
# a Compose secret. It is never copied into this file or the repository.
CODEX_AUTH_SOURCE_PATH=/root/.codex/auth.json
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_API_KEY=
CODEX_AUTH_JSON=/run/secrets/hypertrade_eval_codex_auth
CODEX_MODEL=gpt-5.4
CODEX_MODEL_OPTIONS=gpt-5.4,gpt-5.5,gpt-5.4-mini
CODEX_TIMEOUT_SECONDS=90
ACTIVE_CHAT_PROVIDER=codex

# No private exchange, BitPro, paper, monitoring, Langfuse, or Feishu access is
# provisioned in the evaluation environment. Public OKX reads remain available
# only when an evaluated read tool explicitly requests them.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true
PAPER_ENABLED=false
MONITOR_SCHEDULER_ENABLED=false
BITPRO_MCP_API_BASE=http://127.0.0.1:9/api/v2
BITPRO_MCP_API_TOKEN=
FEISHU_WEBHOOK_URL=
LANGFUSE_ENABLED=false
