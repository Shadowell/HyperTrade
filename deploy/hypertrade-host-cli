#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="${HYPERTRADE_ROOT_DIR:-/opt/hypertrade}"
cd "$ROOT_DIR"

api_url="${HYPERTRADE_API_URL:-http://api:3334}"

env_args=("-e" "HYPERTRADE_API_URL=${api_url}")
for name in \
  HYPERTRADE_USERNAME \
  HYPERTRADE_PASSWORD \
  HYPERTRADE_TIMEOUT_SECONDS \
  HYPERTRADE_RENDERER \
  HYPERTRADE_TRACE \
  HYPERTRADE_THINKING_ANIMATION \
  NO_COLOR
do
  if [ "${!name+x}" = "x" ]; then
    env_args+=("-e" "$name=${!name}")
  fi
done

# docker compose run does not reliably preserve the host TTY state inside the
# short-lived client container. An interactive operator should still receive
# the professional Rich report by default; scripts can explicitly request the
# stable plain renderer.
if [ -t 1 ] && [ "${HYPERTRADE_RENDERER+x}" != "x" ]; then
  env_args+=("-e" "HYPERTRADE_RENDERER=rich")
fi

service="api"
if [ "${1:-}" = "tui" ]; then
  service="cli"
fi

# Run the CLI in a short-lived client container instead of exec'ing into the
# long-running API service. Deploys can replace hypertrade-api without killing
# this terminal session.
exec docker compose run --rm --no-deps "${env_args[@]}" "$service" hypertrade "$@"
