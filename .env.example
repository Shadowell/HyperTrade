# Copy to .env and fill values locally or in /opt/hypertrade/.env on the server.

APP_ENV=development
APP_NAME=HyperTrade
API_HOST=0.0.0.0
API_PORT=3334
FRONTEND_ORIGIN=http://localhost:3333

POSTGRES_DB=hypertrade
POSTGRES_USER=hypertrade
POSTGRES_PASSWORD=hypertrade
DATABASE_URL=postgresql+psycopg://hypertrade:hypertrade@postgres:5432/hypertrade

ADMIN_USERNAME=admin
ADMIN_PASSWORD=hypertrade-admin
SESSION_SECRET=change-me

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com
OKX_REST_SUPPLEMENT_INTERVAL_SECONDS=300

FEISHU_WEBHOOK_URL=
RAG_SCAN_INTERVAL_SECONDS=600
KNOWLEDGE_DIR=docs/knowledge
RAW_MARKET_RETENTION_DAYS=7
LLM_DAILY_SOFT_BUDGET_USD=5.0
