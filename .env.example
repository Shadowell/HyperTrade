# Copy to .env and fill values locally or in /opt/hypertrade/.env on the server.

APP_ENV=development
APP_NAME=HyperTrade
API_HOST=0.0.0.0
API_PORT=3334
FRONTEND_ORIGIN=http://localhost:3333

POSTGRES_DB=hypertrade
POSTGRES_USER=hypertrade
POSTGRES_PASSWORD=hypertrade
DATABASE_URL=postgresql+psycopg://hypertrade:hypertrade@postgres:5432/hypertrade

ADMIN_USERNAME=admin
ADMIN_PASSWORD=hypertrade-admin
SESSION_SECRET=change-me
COOKIE_SECURE=false

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ACTIVE_CHAT_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_API_KEY=
CODEX_AUTH_JSON=~/.codex/auth.json
CODEX_MODEL=gpt-5.4
CODEX_MODEL_OPTIONS=gpt-5.4,gpt-5.5,gpt-5.4-mini
CODEX_TIMEOUT_SECONDS=90
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
QWEN_CHAT_MODEL=qwen-plus

QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com
OKX_REST_SUPPLEMENT_INTERVAL_SECONDS=300

PAPER_ENABLED=true
PAPER_LOOP_INTERVAL_SECONDS=30
PAPER_STARTING_EQUITY_USDT=100000
PAPER_MAX_POSITIONS=10
PAPER_MAX_SYMBOL_NOTIONAL_PCT=0.20
PAPER_MAX_LEVERAGE=5
PAPER_TAKER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=2
RISK_MAX_ORDER_NOTIONAL_USDT=100
RISK_MAX_OPEN_INTENTS=5

FEISHU_WEBHOOK_URL=
RAG_SCAN_INTERVAL_SECONDS=600
KNOWLEDGE_DIR=docs/knowledge
RAW_MARKET_RETENTION_DAYS=7
LLM_DAILY_SOFT_BUDGET_USD=5.0
AGENT_TOOL_TIMEOUT_QUICK_SECONDS=5
AGENT_TOOL_TIMEOUT_STANDARD_SECONDS=30
AGENT_TOOL_TIMEOUT_LONG_SECONDS=120
BITPRO_HOST_DATA_DIR=/opt/bitpro/data
BITPRO_SQLITE_PATH=/bitpro-data/crypto_data.db
# Local host process: http://127.0.0.1:8889/api/v2
# Docker Compose on Linux: http://host.docker.internal:8889/api/v2
BITPRO_MCP_API_BASE=http://127.0.0.1:8889/api/v2
BITPRO_MCP_API_TOKEN=
BITPRO_MCP_AUTH_HEADER=X-BitPro-MCP-Token
BITPRO_MCP_TIMEOUT_SECONDS=15
